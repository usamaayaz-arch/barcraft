<div class="custom-video-section">
  {%- if section.settings.video_section_heading -%}
    <div class="video-heading heading-{{ section.settings.header_size }}">
      {{ section.settings.video_section_heading }}
    </div>
  {%- endif -%}

  <div class="video-container">
    {%- if section.settings.custom_video -%}
      {{
        section.settings.custom_video
        | video_tag:
          image_size: '1024x1024',
          loop: section.settings.video_loop_flag,
          controls: false,
          autoplay: true,
          muted: true
      }}
      <script>
        video = document.querySelector('.video-container video');
        function speed(speed){
          video.defaultPlaybackRate = 1;
          video.play();
          video.playbackRate = speed;
        }
        speed({{section.settings.play_speed}});
        {% if section.settings.play_pause_action == 'play' %}
          video.play();
          {%- else -%}
          video.pause();
          {%  endif %}
      </script>
    {%- elsif section.settings.custom_video_url -%}
      {%- if section.settings.custom_video_url.type == 'youtube' -%}
        <iframe
          style="height:{{ section.settings.video_height }}rem"
          id="videoFrameEditor"
          src="
            https://www.youtube.com/embed/{{ section.settings.custom_video_url.id }}
            ?controls=0
            &modestbranding=1
            &rel=0&autoplay=1&mute=1&loop={%  if section.settings.video_loop_flag ==true%}1{% else %}0{% endif %}&playlist={{ section.settings.custom_video_url.id }}
          "
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<script>
  let videoFrame = document.getElementById('videoFrameEditor');
  videoFrame.controls = false;
</script>

<style>
  .heading-{{ section.settings.header_size }}{
  font-size: {{ section.settings.header_size }};
  }
  .video-container video,
  .video-container iframe {
    width: 100%;
    height: 100%;
  }
</style>
