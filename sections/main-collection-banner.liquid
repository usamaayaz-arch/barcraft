{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{settings.media_shadow_vertical_offset | at_least: 0}}px + 2rem);
    }
  }
{%- endstyle -%}

<div
  style="padding: {% if section.settings.barcraft_main_collection_banner_enable %}0rem;{% else %}inherit{% endif %}"
  class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient"
>
  {% if section.settings.barcraft_main_collection_banner_enable %}
    <style>
      #shopify-section-{{ section.id }} .banner-enabled {
        position: relative;
        height: 28rem;
      }

      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .banner-enabled {
          height: 20rem;
        }
      }
    </style>
  {% endif %}
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %} {% if section.settings.barcraft_main_collection_banner_enable %}banner-enabled{% endif %}">
    <div
      style="{% if section.settings.barcraft_main_collection_banner_enable %}z-index:1;padding-top: 0;padding-bottom: 0;{% endif %} {% if section.settings.text_container_box == true %}width:100%;max-width:{{ section.settings.text_container_width }}rem;{% endif %}"
      class="collection-hero__text-wrapper"
    >
      {% if section.settings.barcraft_main_collection_banner_enable %}
        <style>
          .collection-hero__title {
            font-size: clamp(20px, 4vw, 36px);
            line-height: 1.2;
          }

          .collection-hero__description.rte p {
            font-size: clamp(10px, 2.5vw, 16px);
            line-height: 1.6;
            color: white;
          }

          @media screen and (max-width: 749px) {
            .collection-hero__text-wrapper {
              display: flex;
              flex-direction: column;
              align-items: flex-start;
              justify-content: flex-end;
              height: fit-content;
              width: calc(100% - 3rem) !important;
              z-index: 1;
              padding-top: 0;
              padding-bottom: 0;
              width: 100%;
              max-width: 42rem;
              position: absolute;
              bottom: 26px;
            }
          }
        </style>
      {% endif %}

      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description -%}
        {% if section.settings.text_container_box == true %}
          <style>
            .collection-hero__description.rte {
              margin: 8px 0 0 0;
              letter-spacing: 0;
            }
          </style>
        {% endif %}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div
        style="{% if section.settings.barcraft_main_collection_banner_enable %}position: absolute;top: 0;bottom: 0;left: 0;right: 0;z-index: 0;margin: 0;{% endif %}"
        class="collection-hero__image-container media gradient"
      >
        {% if section.settings.barcraft_main_collection_banner_enable %}
          <style>
            @media screen and (max-width: 749px) {
            .collection-hero__breadcrumb {
              left: 1.5rem !important;
            
            }
            }
            .collection-hero__breadcrumb {
              position: absolute !important;
              z-index: 3;
              font-size: 1rem;
              top: 2rem !important;
            }
            .collection-hero__breadcrumb .collection-hero__breadcrumb_link {
              color: #f9f9f966;
              text-decoration: unset;
            }
          </style>
          <span style="left: 5.5rem" class="collection-hero__breadcrumb">
            <a class="collection-hero__breadcrumb_link" href="/collections">Home / </a>
            <a class="collection-hero__breadcrumb_link" href="{{ collection.url }}">{{ collection.title }}</a></span
          >
        {% endif %}
        {% if section.settings.barcraft_main_collection_banner_enable %}
          <style>
            .overlay_collection_hero{
              display: block;
              background-color: black;
              z-index: 1;
              opacity:{{section.settings.media_shadow_vertical_offset}}
            }
          </style>
          <div class="overlay_collection_hero"></div>
        {% endif %}
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "barcraft_main_collection_banner_enable",
      "default": false,
      "label": "Enable Main Collection Banner"
    },
    {
      "type": "checkbox",
      "id": "text_container_box",
      "default": false,
      "label": "Enable Text Container Box"
    },
    {
      "type": "range",
      "id": "text_container_width",
      "label": "Text Container Width",
      "default": 47,
      "min": 13,
      "max": 50,
      "step": 1,
      "unit": "rem"
    },
    {
      "type": "range",
      "id": "media_shadow_vertical_offset",
      "label": "Image Opacity offset",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.1
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
