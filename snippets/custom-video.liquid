<div class="custom-video-section">
  {%- if section.settings.video_section_heading -%}
    <div class="video-heading heading-{{ section.settings.header_size }}">
      {{ section.settings.video_section_heading }}
    </div>
  {%- endif -%}

  <div class="video-container">
    {%- if section.settings.custom_video -%}
      {{ section.settings.custom_video | video_tag: image_size: '1024x1024', loop: section.settings.video_loop_flag, controls: true }}
    {%- elsif section.settings.custom_video_url -%}
      {%- if section.settings.custom_video_url.type == 'youtube' -%}
        <iframe
          src="https://www.youtube.com/embed/{{ section.settings.custom_video_url.id }}"
          class="js-youtube"
          allow="autoplay; encrypted-media"
          allowfullscreen
          title="{{ section.settings.description | escape }}"
        ></iframe>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<style>
  .video-heading {
    font-size: 32px;
  }

  .video-container video,
  .video-container iframe {
    width: 100%;
    height: 100%;
  }
</style>
